# For local Docker Compose. Change passwords before using a shared machine.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
ENVIRONMENT=development
APP_URL=http://localhost:8000
ADMIN_PASSWORD=replace-with-a-long-dashboard-password
SESSION_SECRET=replace-with-at-least-32-random-characters

# For a cloud deployment set ENVIRONMENT=production and APP_URL=https://your-domain.
# Managed Postgres: use postgresql+psycopg://user:password@host:5432/database
# DATABASE_URL is optional locally; Compose supplies its internal database URL.

SEARCH_TIME=06:00
DIGEST_TIME=07:00
MAX_PAGES=3
MAX_JOBS=150
REQUEST_DELAY=1.5

# Optional until you are ready to enable email. Never commit real secrets.
EMAIL_TO=
EMAIL_FROM=
RESEND_API_KEY=

# Free cloud variant (set via Render secrets / GitHub Actions, not in Git):
# DEPLOYMENT_MODE=free
# EMAIL_DELIVERY_EXTERNAL=true  # Render dashboard only
# DATABASE_URL=postgresql://...?...sslmode=require
# GitHub variable SCOUT_APP_URL=https://your-dashboard.onrender.com
